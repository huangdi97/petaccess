{
  "id": "home",
  "title": "Home Contract — Consumer Discovery v9",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "pages": [
    {
      "id": "home-ready",
      "route": "/",
      "expect": {
        "page": "home",
        "state": "ready",
        "fixture": "home-ready-v1",
        "h1": "去之前，先看看这里的规则和现场。"
      }
    }
  ],
  "elements": [
    {
      "id": "HOME_QUERY_CONTEXT",
      "ui": "query-context",
      "fallbacks": [
        "[data-testid='query-context']"
      ],
      "props": {
        "count": {
          "min": 1
        }
      },
      "severity": "FAIL"
    },
    {
      "id": "HOME_PRIMARY_SEARCH",
      "ui": "home-search",
      "fallbacks": [
        "[data-testid='home-search']"
      ],
      "props": {
        "count": {
          "min": 1
        }
      },
      "severity": "FAIL"
    },
    {
      "id": "HOME_SEARCH_INPUT_HEIGHT",
      "ui": "home-search-input",
      "fallbacks": [
        "[data-testid='home-search-input']"
      ],
      "props": {
        "height": {
          "min": 44
        }
      },
      "severity": "FAIL"
    },
    {
      "id": "HOME_NEARBY_SECTION",
      "ui": "home-nearby",
      "fallbacks": [
        "[data-testid='home-freshness'], [data-testid='home-empty']"
      ],
      "props": {
        "count": {
          "min": 1
        }
      },
      "severity": "WARN"
    },
    {
      "id": "HOME_DISCOVERY_WIDTH",
      "ui": "home",
      "fallbacks": [
        ".page--home",
        "[data-ui='home']"
      ],
      "props": {
        "width": {
          "min": 1080,
          "max": 1160
        }
      },
      "severity": "FAIL",
      "note": "Consumer Discovery v9 desktop uses a wider hospitality-style discovery canvas while keeping task focus and factual density."
    }
  ],
  "structure": [
    {
      "id": "HOME_NO_PERSPECTIVE_TRIO",
      "selector": "[data-ui='home-perspectives'], .home-perspectives, [data-testid^='perspective-']",
      "max": 0,
      "severity": "FAIL"
    },
    {
      "id": "HOME_NO_FEATURE_CARD_WALL",
      "selector": "[data-ui='home'] .feature-card, .home-feature-card",
      "max": 0,
      "severity": "FAIL"
    },
    {
      "id": "HOME_LENS_IS_LINK_ROWS",
      "selector": "[data-ui='home-lens'], .home-lens",
      "containsArrows": true,
      "severity": "WARN"
    },
    {
      "id": "HOME_RECOMMEND_PRESENT",
      "selector": "[data-ui='home-recommend']",
      "min": 1,
      "severity": "FAIL"
    },
    {
      "id": "HOME_DIVERGENCE_NOT_CARD_WALL",
      "selector": "[data-ui='home-divergence'] .home-divergence__row",
      "forbiddenClass": [
        "card",
        "panel"
      ],
      "severity": "FAIL"
    },
    {
      "id": "HOME_FOUR_TASK_LENSES",
      "selector": "[data-ui='home-lens'] button",
      "min": 4,
      "max": 4,
      "severity": "FAIL",
      "mustContainTexts": [
        "现场是否有动物出现",
        "室内空间情况",
        "餐饮区域情况",
        "完整规则"
      ]
    },
    {
      "id": "HOME_NEARBY_SPATIAL_IDENTITY",
      "selector": "[data-ui='home-nearby'] [data-ui='place-type-glyph']",
      "min": 1,
      "severity": "WARN",
      "note": "Nearby rows use neutral place-type identity anchors rather than decorative/fake photos."
    }
  ],
  "density": [
    {
      "id": "HOME_MAX_SEMANTIC_GAP",
      "selector": "[data-ui='home']",
      "metric": "largestVerticalGap",
      "max": 180,
      "severity": "FAIL"
    }
  ],
  "language": {
    "uuid": true,
    "enums": true,
    "invariants": true,
    "allcapsTokens": true,
    "refs": true
  },
  "notes": "Consumer Discovery v9: Home is a search-first city-space discovery landing. The abstract city illustration is decorative context only, never venue/evidence media. Canonical order remains Query -> Search -> four task lenses -> nearby digest -> Rule/Reality overview -> divergence -> recent. Preference changes ordering/emphasis only, never venue scoring or facts."
}
