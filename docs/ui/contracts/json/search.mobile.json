{
  "id": "search.mobile",
  "title": "Search Mobile Contract v0.2.3 Executable Blueprint",
  "viewport": {
    "width": 430,
    "height": 932
  },
  "pages": [
    {
      "id": "search-mobile-ready",
      "route": "/#/search",
      "expect": {
        "page": "search",
        "state": "ready",
        "fixture": "search-ready-v1",
        "h1": "搜索场所的规则与现场",
        "componentCounts": [
          {
            "selector": "result-rows",
            "min": 3
          }
        ]
      }
    },
    {
      "id": "search-mobile-filter",
      "route": "/#/search",
      "interactions": [
        {
          "clickSelectors": ["[data-testid='filter-toggle']"],
          "waitForSelector": "[data-ui='search-filter-sheet']"
        }
      ],
      "expect": {
        "page": "search",
        "state": "filter",
        "fixture": "search-filter-v1",
        "h1": "搜索场所的规则与现场"
      }
    }
  ],
  "elements": [
    {
      "id": "SEARCH_MOBILE_DETAIL_PANE_ABSENT",
      "ui": "search-detail-pane",
      "fallbacks": ["[data-testid='decision-inspector']"],
      "props": {
        "count": {
          "max": 0
        }
      },
      "severity": "FAIL"
    },
    {
      "id": "SEARCH_MOBILE_INPUT_HEIGHT",
      "ui": "search-input",
      "fallbacks": ["[data-testid='search-input']"],
      "props": {
        "height": {
          "min": 44,
          "max": 46
        }
      },
      "severity": "FAIL"
    },
    {
      "id": "SEARCH_MOBILE_ROW_HEIGHT",
      "ui": "search-result-row",
      "fallbacks": ["ul.result-list li"],
      "props": {
        "height": {
          "min": 112,
          "max": 132
        }
      },
      "severity": "FAIL",
      "aggregate": "rows"
    },
    {
      "id": "SEARCH_MOBILE_ROW_RADIUS_ZERO",
      "ui": "search-result-row",
      "fallbacks": ["ul.result-list li"],
      "props": {
        "borderRadius": {
          "equals": "0"
        }
      },
      "severity": "FAIL",
      "aggregate": "rows"
    },
    {
      "id": "SEARCH_MOBILE_ROW_SHADOW_NONE",
      "ui": "search-result-row",
      "fallbacks": ["ul.result-list li"],
      "props": {
        "boxShadow": {
          "equals": "none"
        }
      },
      "severity": "FAIL",
      "aggregate": "rows"
    },
    {
      "id": "SEARCH_MOBILE_BOTTOM_NAV_HEIGHT",
      "ui": "mobile-tabbar",
      "fallbacks": ["[data-testid='mobile-tabbar']", "nav[data-testid*='tabbar']"],
      "props": {
        "height": {
          "min": 58,
          "max": 64
        }
      },
      "severity": "FAIL"
    },
    {
      "id": "SEARCH_MOBILE_FILTER_TOGGLE",
      "ui": "search-filter-toggle",
      "fallbacks": ["[data-testid='filter-toggle']"],
      "props": {
        "count": {
          "min": 1
        }
      },
      "severity": "FAIL"
    },
    {
      "id": "SEARCH_MOBILE_SHEET_TOP",
      "ui": "search-filter-sheet",
      "fallbacks": ["[data-testid='search-filter-sheet']"],
      "props": {
        "top": {
          "min": 340,
          "max": 480
        }
      },
      "severity": "WARN",
      "pages": ["search-mobile-filter"]
    },
    {
      "id": "SEARCH_MOBILE_SHEET_RADIUS",
      "ui": "search-filter-sheet",
      "fallbacks": ["[data-testid='search-filter-sheet']"],
      "props": {
        "borderRadius": {
          "min": 14,
          "max": 18
        }
      },
      "severity": "FAIL",
      "pages": ["search-mobile-filter"]
    }
  ],
  "structure": [
    {
      "id": "SEARCH_MOBILE_NO_CARD_ROWS",
      "selector": "ul.result-list li",
      "forbiddenClass": ["card", "panel"],
      "severity": "FAIL"
    },
    {
      "id": "SEARCH_MOBILE_FILTER_IS_SHEET",
      "selector": "[data-testid='search-filter-sheet'], [data-ui='search-filter-sheet']",
      "minVisibleAfterClick": 1,
      "severity": "FAIL"
    },
    {
      "id": "SEARCH_MOBILE_SHEET_FIVE_FILTER_ROWS",
      "selector": "[data-ui='search-filter-sheet'] .filter-options__row",
      "min": 5,
      "severity": "FAIL"
    },
    {
      "id": "SEARCH_MOBILE_NO_FILTER_CARDS",
      "selector": "[data-ui='search-filter-sheet'] .filter-options__row",
      "forbiddenClass": ["card", "panel"],
      "severity": "FAIL"
    },
    {
      "id": "SEARCH_MOBILE_REALITY_PRESENT",
      "selector": "[data-testid='result-reality'], [data-testid='row-lens-headline']",
      "min": 1,
      "severity": "FAIL"
    },
    {
      "id": "SEARCH_MOBILE_DEFAULT_REALITY_FIRST",
      "selector": "[data-testid='row-lens-headline'].result-row__reality-line--lead",
      "min": 1,
      "severity": "FAIL",
      "pages": ["search-mobile-ready"]
    },
    {
      "id": "SEARCH_MOBILE_RULE_STAYS_VISIBLE",
      "selector": ".result-row__head-right .status-badge, [data-testid='row-rule-condition']",
      "min": 1,
      "severity": "FAIL",
      "pages": ["search-mobile-ready"],
      "note": "Rule remains visible as one semantic badge; only a relevant condition consumes another line."
    },
    {
      "id": "SEARCH_MOBILE_SPATIAL_IDENTITY",
      "selector": "[data-ui='search-results-pane'] [data-ui='place-type-glyph']",
      "min": 1,
      "severity": "WARN",
      "note": "Neutral spatial identity anchor improves scanning without decorative/fake place photography."
    }
  ],
  "density": [
    {
      "id": "SEARCH_MOBILE_FIRST_VIEWPORT_FILL",
      "selector": "[data-ui='search-results-pane'], .search-result-pane",
      "metric": "contentHeightInViewport",
      "min": 200,
      "severity": "WARN"
    }
  ],
  "hierarchy": [
    {
      "id": "SEARCH_MOBILE_PRIMARY_HEADLINE_TO_BODY",
      "a": ".result-row__reality-line--lead, .result-row__decision--lead",
      "b": "body",
      "minRatio": 1.1,
      "severity": "WARN",
      "note": "Default search is Reality-first; explicit Rules lens promotes Rule. Measure whichever semantic headline owns the row."
    },
    {
      "id": "SEARCH_MOBILE_METADATA_SMALLER",
      "a": ".result-row__meta",
      "b": "body",
      "maxRatio": 1,
      "severity": "WARN"
    }
  ],
  "budget": [
    {
      "id": "SEARCH_MOBILE_ROW_TEXT_LINES",
      "metric": "rowTextLines",
      "selector": "ul.result-list",
      "max": 7,
      "severity": "FAIL",
      "note": "Mobile keeps the same <=5 semantic groups. The rendered-line probe counts wrapped compact text and the adjacent semantic badge separately at 430px, so 7 is the machine ceiling rather than permission to add more groups."
    },
    {
      "id": "SEARCH_MOBILE_FIRST_VIEWPORT_LINES",
      "metric": "firstViewportTextLines",
      "selector": "[data-ui='search-results-pane']",
      "max": 46,
      "warnAt": 40,
      "severity": "WARN"
    }
  ],
  "composition": [
    {
      "id": "SEARCH_MOBILE_STATUS_REPEAT",
      "metric": "primaryStatusRepeatCount",
      "selector": "[data-ui='search-results-pane']",
      "text": "有条件",
      "max": 3,
      "severity": "WARN"
    }
  ],
  "language": {
    "uuid": true,
    "enums": true,
    "invariants": true,
    "allcapsTokens": true,
    "refs": true
  },
  "notes": "Canonical v0.10-R1: mobile search keeps one Rule semantic status + Reality headline + only relevant condition + Evidence/freshness in the divider row, with a filter bottom sheet. Default search is Reality-first; an explicit rules lens flips emphasis."
}
