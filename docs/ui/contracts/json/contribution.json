{
  "id": "contribution",
  "title": "Contribution Contract",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "pages": [
    {
      "id": "contribute-needs-place",
      "route": "/#/contribute",
      "expect": {
        "page": "contribution",
        "state": "needs-place",
        "fixture": "contribution-needs-place-v1",
        "h1": "现场贡献"
      }
    },
    {
      "id": "contribute-entry",
      "route": "/#/contribute/5a9084d0-d2c7-5bb3-9914-fa7a11c53d9e",
      "auth": true,
      "expect": {
        "page": "contribution",
        "state": "choose-type",
        "fixture": "contribution-choose-type-v1",
        "h1": "你刚刚知道了什么？",
        "componentCounts": [
          {
            "selector": "choice-count",
            "min": 5
          }
        ]
      }
    },
    {
      "id": "contribute-step-1",
      "route": "/#/contribute/5a9084d0-d2c7-5bb3-9914-fa7a11c53d9e",
      "auth": true,
      "interactions": [
        {
          "clickSelectors": ["[data-testid='entry-quick']"],
          "waitForSelector": "[data-testid='quick-submit']"
        }
      ],
      "expect": {
        "page": "contribution",
        "state": "step-1",
        "fixture": "contribution-step-1-v1",
        "h1": "现场贡献"
      }
    },
    {
      "id": "contribute-step-2",
      "route": "/#/contribute/5a9084d0-d2c7-5bb3-9914-fa7a11c53d9e",
      "auth": true,
      "interactions": [
        {
          "clickSelectors": ["[data-testid='entry-reality-observed_presence']"],
          "waitForSelector": "[data-testid='reality-submit']"
        }
      ],
      "expect": {
        "page": "contribution",
        "state": "step-2",
        "fixture": "contribution-step-2-v1",
        "h1": "现场贡献"
      }
    }
  ],
  "elements": [
    {
      "id": "CONTRIBUTE_FIRST_SCREEN",
      "ui": "contribution-flow",
      "fallbacks": ["[data-testid='contribute-entry'], .contribute-entry"],
      "props": {
        "count": {
          "min": 1
        }
      },
      "severity": "FAIL",
      "pages": ["contribute-entry"]
    },
    {
      "id": "CONTRIBUTION_MAIN_COLUMN_BOUNDED",
      "ui": "contribution-main",
      "fallbacks": [".contribute-workspace__main"],
      "props": {
        "width": {
          "min": 620,
          "max": 760
        }
      },
      "severity": "FAIL",
      "pages": ["contribute-entry", "contribute-step-1", "contribute-step-2"],
      "note": "v0.2.7 §16/§40：main task column 620–720px（容差到 760）。"
    },
    {
      "id": "CONTRIBUTION_CONTEXT_VISIBLE",
      "ui": "contribution-context",
      "fallbacks": [".contribute-workspace__context"],
      "props": {
        "count": {
          "min": 1
        },
        "width": {
          "min": 240,
          "max": 320
        }
      },
      "severity": "FAIL",
      "pages": ["contribute-entry", "contribute-step-1", "contribute-step-2"],
      "note": "v0.2.7 §15/§40：desktop secondary context rail 240–300px 真实可见。"
    },
    {
      "id": "CONTRIBUTION_WORKSPACE_NO_HORIZONTAL_OVERFLOW",
      "ui": "contribution-workspace",
      "fallbacks": [".contribute-workspace"],
      "props": { "hOverflow": { "equals": 0 } },
      "severity": "FAIL",
      "pages": ["contribute-entry", "contribute-step-1", "contribute-step-2"],
      "note": "v0.2.7-R1 P0-1 nested: workspace scrollWidth <= clientWidth + 1."
    },
    {
      "id": "CONTRIBUTION_MAIN_NO_HORIZONTAL_OVERFLOW",
      "ui": "contribution-main",
      "fallbacks": [".contribute-workspace__main"],
      "props": { "hOverflow": { "equals": 0 } },
      "severity": "FAIL",
      "pages": ["contribute-entry", "contribute-step-1", "contribute-step-2"],
      "note": "v0.2.7-R1 P0-1 nested: main column scrollWidth <= clientWidth + 1."
    },
    {
      "id": "CONTRIBUTION_CONTEXT_NO_HORIZONTAL_OVERFLOW",
      "ui": "contribution-context",
      "fallbacks": [".contribute-workspace__context"],
      "props": { "hOverflow": { "equals": 0 } },
      "severity": "FAIL",
      "pages": ["contribute-entry", "contribute-step-1", "contribute-step-2"],
      "note": "v0.2.7-R1 P0-1 nested: context rail scrollWidth <= clientWidth + 1."
    }
  ],
  "structure": [
    {
      "id": "CONTRIBUTE_QUESTION_TEXT",
      "selector": "body",
      "mustContainText": "你刚刚知道了什么",
      "severity": "FAIL",
      "pages": ["contribute-entry"]
    },
    {
      "id": "CONTRIBUTE_5_OPTIONS",
      "selector": "[data-ui='contribution-flow'] button, .contribute-entry button, [data-testid^='entry-']",
      "min": 5,
      "severity": "FAIL",
      "pages": ["contribute-entry"]
    },
    {
      "id": "CONTRIBUTE_OPTION_LABELS",
      "selector": "body",
      "mustContainTexts": [
        "我看到或了解到一条规则",
        "我在现场看到动物",
        "工作人员进行了处理",
        "我发现了相关设施",
        "场所信息有误"
      ],
      "severity": "FAIL",
      "pages": ["contribute-entry"]
    },
    {
      "id": "CONTRIBUTE_NEEDS_PLACE_GUARD",
      "selector": "[data-testid='contribute-needs-place']",
      "min": 1,
      "severity": "FAIL",
      "pages": ["contribute-needs-place"]
    },
    {
      "id": "CONTRIBUTE_NEEDS_PLACE_HIDES_QUERY",
      "selector": "[data-testid='query-context']",
      "max": 0,
      "severity": "FAIL",
      "pages": ["contribute-needs-place"]
    },
    {
      "id": "CONTRIBUTE_LOCATION_COPY_CORRECT",
      "selector": "body",
      "mustContainTexts": ["提交内容会进入人工核验"],
      "forbiddenText": ["ADR-", "GPS 轨迹（", "位置信息仅用于核验场所，不保存连续位置轨迹"],
      "severity": "FAIL",
      "pages": ["contribute-entry", "contribute-step-1", "contribute-step-2"]
    },
    {
      "id": "CONTRIBUTE_4_CHOICES_FIRST_VIEWPORT",
      "selector": "[data-ui='contribution-flow'] .entry-option__button, [data-testid^='entry-']",
      "minVisibleInViewport": 4,
      "severity": "FAIL",
      "pages": ["contribute-entry"]
    },
    {
      "id": "CONTRIBUTION_STEP_CONTEXT_PRESENT",
      "selector": "[data-testid='step-place-context'], [data-testid='contribute-step'], [data-testid='quick-submit'], [data-testid='step-back']",
      "min": 4,
      "severity": "FAIL",
      "pages": ["contribute-step-1"]
    },
    {
      "id": "CONTRIBUTION_OPTION_ROWS_NOT_PILLS",
      "selector": "[data-testid='quick-options'] .option-row",
      "min": 3,
      "forbiddenClass": ["pill"],
      "severity": "FAIL",
      "pages": ["contribute-step-1"]
    }
  ],
  "density": [
    {
      "id": "CONTRIBUTION_FIELD_GROUP_RHYTHM",
      "selector": "[data-ui='contribution-form']",
      "metric": "largestVerticalGap",
      "min": 16,
      "max": 40,
      "severity": "FAIL",
      "pages": ["contribute-step-2"],
      "note": "v0.2.7 §19/§40：When/Where/What 三组间距 20–28px 稳定节奏。"
    }
  ],
  "composition": [
    {
      "id": "CONTRIBUTION_DESKTOP_WORKSPACE_BALANCE",
      "metric": "inspectorOccupancy",
      "selector": "[data-ui='contribution-main']",
      "container": "[data-ui='contribution-workspace']",
      "min": 0.55,
      "max": 0.8,
      "severity": "FAIL",
      "pages": ["contribute-entry", "contribute-step-1", "contribute-step-2"],
      "note": "v0.2.7 §15/§40：main column 占 workspace 55–80%，宽屏构图平衡。"
    }
  ],
  "hierarchy": [
    {
      "id": "PRIMARY_CONTENT_DOMINATES_METADATA",
      "a": ".entry-question",
      "b": ".entry-hint",
      "minRatio": 1.4,
      "severity": "FAIL",
      "pages": ["contribute-entry"],
      "note": "v0.2.7 §40：question 必须显著强于 metadata/hint。"
    }
  ],
  "language": {
    "uuid": true,
    "enums": true,
    "invariants": true,
    "allcapsTokens": true,
    "refs": true
  },
  "notes": "v0.2.3 §40/§41: first screen 你刚刚知道了什么？ with exactly 5 fixed options; consumer copy has no ADR/RFC/TD/UUID/enum (location copy uses the spec-correct wording 位置信息仅用于核验场所，不保存连续位置轨迹). Wizard O6 states: choose-type (entry) -> step-1 (legacy confirm) -> step-2 (reality parent-flow) -> done. Entry probed authenticated (pa_token via API, same as contribute-wizard e2e)."
}
