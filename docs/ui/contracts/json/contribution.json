{
  "id": "contribution",
  "title": "Contribution Contract",
  "viewport": { "width": 1440, "height": 900 },
  "pages": [
    { "id": "contribute-needs-place", "route": "/#/contribute" },
    {
      "id": "contribute-entry",
      "route": "/#/contribute/5a9084d0-d2c7-5bb3-9914-fa7a11c53d9e",
      "auth": true
    }
  ],
  "elements": [
    {
      "id": "CONTRIBUTE_FIRST_SCREEN",
      "ui": "contribution-flow",
      "fallbacks": ["[data-testid='contribute-entry'], .contribute-entry"],
      "props": { "count": { "min": 1 } },
      "severity": "FAIL",
      "pages": ["contribute-entry"]
    }
  ],
  "structure": [
    {
      "id": "CONTRIBUTE_QUESTION_TEXT",
      "selector": "body",
      "mustContainText": "你刚刚知道了什么",
      "severity": "FAIL",
      "pages": ["contribute-entry"]
    },
    {
      "id": "CONTRIBUTE_5_OPTIONS",
      "selector": "[data-ui='contribution-flow'] button, .contribute-entry button, [data-testid^='entry-']",
      "min": 5,
      "severity": "FAIL",
      "pages": ["contribute-entry"]
    },
    {
      "id": "CONTRIBUTE_OPTION_LABELS",
      "selector": "body",
      "mustContainTexts": [
        "我看到了新的规则",
        "我在现场看到动物",
        "工作人员进行了处理",
        "我发现了相关设施",
        "场所信息有误"
      ],
      "severity": "FAIL",
      "pages": ["contribute-entry"]
    },
    {
      "id": "CONTRIBUTE_NEEDS_PLACE_GUARD",
      "selector": "[data-testid='contribute-needs-place']",
      "min": 1,
      "severity": "FAIL",
      "pages": ["contribute-needs-place"]
    },
    {
      "id": "CONTRIBUTE_NEEDS_PLACE_HIDES_QUERY",
      "selector": "[data-testid='query-context']",
      "max": 0,
      "severity": "FAIL",
      "pages": ["contribute-needs-place"]
    }
  ],
  "density": [],
  "language": { "uuid": true, "enums": true, "invariants": true, "allcapsTokens": true },
  "notes": "Real transaction flow: entry -> focused steps -> 已提交待核验. Never '规则已更新' on submit. Tests must cover guard/entry/step/submit/mobile (contribute-wizard e2e). The entry page is probed in an authenticated state (pa_token via API, same as contribute-wizard e2e)."
}
