      }
    },
    {
      "id": "evidence-records",
      "route": "/#/place/5a9084d0-d2c7-5bb3-9914-fa7a11c53d9e/evidence",
      "expect": {
        "page": "evidence",
        "state": "ready",
        "fixture": "evidence-records-v1",
        "h1": "证据与来源"
      }
    }
  ],
  "elements": [
    {
      "id": "EVIDENCE_MAX_WIDTH",
      "ui": "evidence-body",
      "fallbacks": [
        ".evidence-workspace__body"
      ],
      "props": {
        "width": {
          "min": 780,
          "max": 824
        }
      },
      "severity": "FAIL"
    },
    {
      "id": "EVIDENCE_PROVENANCE",
      "ui": "evidence-provenance",
      "fallbacks": [
        "[data-testid='evidence-provenance']"
      ],
      "props": {
        "count": {
          "min": 1
        }
      },
      "severity": "FAIL"
    },
    {
      "id": "EVIDENCE_RAIL_WIDTH",
      "ui": "evidence-prov-rail-line",
      "fallbacks": [
        ".provenance-rail__line"
      ],
      "props": {
        "width": {
          "equals": 2
        }
      },
      "severity": "FAIL"
    },
    {
      "id": "EVIDENCE_RAIL_CONTINUOUS",
      "ui": "evidence-prov-rail-line",
      "fallbacks": [
        ".provenance-rail__line"
      ],
      "props": {
        "height": {
          "min": 140
        }
      },
      "severity": "FAIL"
    },
    {
      "id": "EVIDENCE_MARKER_COL",
      "ui": "evidence-prov-step",
      "fallbacks": [
        ".provenance-step"
      ],
      "props": {
        "gridTemplateColumns": {
          "startsWith": "24px"
        }
      },
      "severity": "FAIL"
    },
    {
      "id": "EVIDENCE_ITEMS",
      "ui": "evidence-items",
      "fallbacks": [
        "[data-testid='evidence-items']"
      ],
      "props": {
        "count": {
          "min": 1
        }
      },
      "severity": "WARN"
    },
    {
      "id": "EVIDENCE_SOURCES",
      "ui": "evidence-sources",
      "fallbacks": [
        "[data-testid='evidence-sources']"
      ],
      "props": {
        "count": {
          "min": 1
        }
      },
      "severity": "WARN"
    },
    {
      "id": "EVIDENCE_QUERY_CONTEXT",
      "ui": "query-context",
      "fallbacks": [
        "[data-testid='query-context']"
      ],
      "props": {
        "count": {
          "min": 1
        }
      },
      "severity": "FAIL"
    }
  ],
  "structure": [
    {
      "id": "EVIDENCE_PROVENANCE_5_STEPS",
      "selector": "[data-ui='evidence-prov-step'], .provenance-step",
      "min": 5,
      "max": 5,
      "severity": "FAIL"
    },
    {
      "id": "EVIDENCE_PROVENANCE_STEP_LABELS",
      "selector": "body",
      "mustContainTexts": [
        "原始证据",
        "地点匹配",
        "时间确认",
        "来源确认",
        "人工核验"
      ],
      "severity": "FAIL"
    },
    {
      "id": "EVIDENCE_MARKER_X_CONSISTENT",
      "selector": "[data-ui='evidence-prov-marker'], .provenance-step__mark",
      "xConsistent": true,
      "severity": "FAIL"
    },
    {
      "id": "EVIDENCE_DISCLAIMER",
      "selector": "[data-testid='evidence-disclaimer'], [data-ui='evidence-disclaimer']",
      "mustContainText": "现场事实不代表正式准入规则",
      "severity": "FAIL"
    },
    {
      "id": "EVIDENCE_NO_UUID_TEXT",
      "selector": "body",
      "forbiddenText": [],
      "uuidForbidden": true,
      "severity": "FAIL"
    },
    {
      "id": "EVIDENCE_TIMES_SEPARATED",
      "selector": "[data-ui='evidence-times'] .evidence-timefact",
      "severity": "FAIL",
      "min": 3,
      "max": 3
    },
    {
      "id": "EVIDENCE_RECORD_IDENTITY_VISIBLE",
      "selector": "[data-testid='evidence-head']",
      "minVisibleInViewport": 1,
      "severity": "FAIL",
      "pages": [
        "evidence-records"
      ]
    },
    {
      "id": "EVIDENCE_PROVENANCE_3_STEPS_VISIBLE",
      "selector": "[data-ui='evidence-prov-step'], .provenance-step",
      "minVisibleInViewport": 3,
      "severity": "FAIL",
      "pages": [
        "evidence-records"
      ]
    }
  ],
  "density": [
    {
      "id": "EVIDENCE_PROV_STEP_GAP",
      "selector": "[data-ui='evidence-prov-rail'], .provenance-rail",
      "metric": "largestVerticalGap",
      "min": 28,
      "max": 36,
      "severity": "FAIL"
    }
  ],
  "language": {
    "uuid": true,
    "enums": true,
    "invariants": true,
    "allcapsTokens": true,
    "refs": true
  },
  "notes": "v0.2.3 §39 + v0.10-R1: content max width 820, provenance marker col 24px + content remaining, marker x identical, continuous rail, step gap 28-36, exactly 5 steps (原始证据/地点匹配/时间确认/来源确认/人工核验), no UUIDs. ready = 云栖中心（published v0.9 Reality + Rule evidence）；empty = 星河咖啡（legacy observation 不再当作 Consumer evidence truth）。"
}
