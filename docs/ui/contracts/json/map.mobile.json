{
  "id": "map.mobile",
  "title": "Map Mobile Contract v0.2.5 (overlay bottom sheet §22–24/§49)",
  "viewport": {
    "width": 430,
    "height": 932
  },
  "pages": [
    {
      "id": "map-mobile-ready",
      "route": "/#/map",
      "expect": {
        "page": "map",
        "state": "ready",
        "fixture": "map-ready-v1",
        "h1": "规则与现场地图"
      }
    },
    {
      "id": "map-mobile-selected-half",
      "route": "/#/map?place=8412b521-5e1c-505d-9dec-568acb860c76",
      "expect": {
        "page": "map",
        "state": "ready",
        "fixture": "map-ready-v1",
        "h1": "规则与现场地图"
      }
    },
    {
      "id": "map-mobile-expanded",
      "route": "/#/map?place=8412b521-5e1c-505d-9dec-568acb860c76",
      "interactions": [
        {
          "clickSelectors": ["[data-testid='sheet-handle']"],
          "waitForSelector": "[data-testid='sheet-verdict']"
        }
      ],
      "expect": {
        "page": "map",
        "state": "ready",
        "fixture": "map-ready-v1",
        "h1": "规则与现场地图"
      }
    },
    {
      "id": "map-mobile-reality",
      "route": "/#/map?lens=reality",
      "expect": {
        "page": "map",
        "state": "ready",
        "fixture": "map-ready-v1",
        "h1": "规则与现场地图"
      }
    }
  ],
  "elements": [
    {
      "id": "MAP_MOBILE_TOGGLE_SEGMENTED",
      "props": {
        "count": {
          "min": 2
        }
      },
      "severity": "FAIL",
      "fallbacks": ["[data-testid='view-map'], [data-testid='view-list']"]
    },
    {
      "id": "MAP_MOBILE_SHEET_OVERLAY",
      "ui": "map-mobile-sheet",
      "fallbacks": ["[data-testid='map-mobile-sheet']"],
      "props": {
        "count": {
          "min": 1
        },
        "position": {
          "equals": "absolute"
        },
        "borderRadius": {
          "min": 14,
          "max": 18
        }
      },
      "severity": "FAIL",
      "pages": ["map-mobile-selected-half"]
    },
    {
      "id": "MAP_MOBILE_SHEET_ABOVE_TABBAR",
      "ui": "map-mobile-sheet",
      "fallbacks": ["[data-testid='map-mobile-sheet']"],
      "props": {
        "top": {
          "min": 300,
          "max": 700
        },
        "height": {
          "min": 180,
          "max": 360
        }
      },
      "severity": "FAIL",
      "pages": ["map-mobile-selected-half"]
    },
    {
      "id": "MAP_MOBILE_SHEET_EXPANDED_HEIGHT",
      "ui": "map-mobile-sheet",
      "fallbacks": ["[data-testid='map-mobile-sheet']"],
      "props": {
        "height": {
          "min": 340,
          "max": 680
        }
      },
      "severity": "FAIL",
      "pages": ["map-mobile-expanded"],
      "note": "Expanded sheet must visibly exceed half state and remain below the tab bar; sparse content should fit naturally without artificial filler."
    },
    {
      "id": "MAP_MOBILE_LENSBAR_PRESENT",
      "ui": "map-lensbar",
      "fallbacks": ["[data-ui='map-lensbar']"],
      "props": {
        "count": {
          "min": 1
        }
      },
      "severity": "FAIL"
    }
  ],
  "structure": [
    {
      "id": "MAP_MOBILE_SHEET_NO_OUTLINE_STATUS",
      "selector": "[data-testid='map-mobile-sheet'] .status-badge--block, [data-testid='map-mobile-sheet'] [style*='border']",
      "max": 0,
      "severity": "FAIL",
      "pages": ["map-mobile-selected-half"]
    },
    {
      "id": "MAP_EXPANDED_NO_FAKE_FILLER",
      "selector": "[data-testid='map-mobile-sheet'] [class*='placeholder'], [data-testid='map-mobile-sheet'] [data-ui*='filler'], [data-testid='map-mobile-sheet'] [class*='lorem']",
      "max": 0,
      "severity": "FAIL",
      "pages": ["map-mobile-expanded"],
      "note": "v0.2.7 §13/§40：expanded 禁止伪造/占位内容，只允许真实已有信息。"
    },
    {
      "id": "MAP_MOBILE_FOUR_LENSES",
      "selector": "[data-ui='map-lensbar'] button",
      "min": 4,
      "max": 4,
      "severity": "FAIL",
      "mustContainTexts": ["规则", "现场", "设施", "规则×现场"]
    },
    {
      "id": "MAP_MOBILE_ONE_ACTIVE_LENS",
      "selector": "[data-ui='map-lensbar'] button[aria-pressed='true']",
      "min": 1,
      "max": 1,
      "severity": "FAIL"
    },
    {
      "id": "MAP_MOBILE_ZOOM_CONTROLS_INTERACTIVE",
      "selector": "[data-ui='map-zoom'] button:not(:disabled)",
      "min": 1,
      "severity": "FAIL",
      "pages": ["map-mobile-ready", "map-mobile-reality"]
    }
  ],
  "density": [
    {
      "id": "MAP_MOBILE_SHEET_CONTENT_DENSITY",
      "selector": "[data-testid='map-mobile-sheet'] .sheet__body",
      "metric": "largestVerticalGap",
      "min": 8,
      "max": 58,
      "severity": "FAIL",
      "pages": ["map-mobile-selected-half", "map-mobile-expanded"],
      "note": "Expanded content may breathe, but actions must not be pinned down to manufacture empty space."
    }
  ],
  "composition": [
    {
      "id": "MAP_EXPANDED_REAL_BLOCKS",
      "metric": "semanticBlockCount",
      "selector": "[data-testid='map-mobile-sheet']",
      "min": 3,
      "max": 6,
      "severity": "FAIL",
      "pages": ["map-mobile-expanded"],
      "note": "v0.2.7 §13：expanded 只含真实信息块（decision/condition/reality/evidence/CTA）。"
    }
  ],
  "hierarchy": [
    {
      "id": "PRIMARY_CONTENT_DOMINATES_METADATA",
      "a": "[data-testid='map-mobile-sheet'] .sheet__name",
      "b": "[data-testid='map-mobile-sheet'] .sheet__meta",
      "minRatio": 1.3,
      "severity": "FAIL",
      "pages": ["map-mobile-selected-half", "map-mobile-expanded"]
    },
    {
      "id": "STATUS_BADGE_NOT_PRIMARY",
      "a": "[data-testid='map-mobile-sheet'] .status-badge",
      "b": "[data-testid='map-mobile-sheet'] .sheet__name",
      "maxRatio": 0.9,
      "severity": "FAIL",
      "pages": ["map-mobile-selected-half", "map-mobile-expanded"]
    }
  ],
  "language": {
    "uuid": true,
    "enums": true,
    "invariants": true,
    "allcapsTokens": true,
    "refs": true
  },
  "notes": "Mobile map keeps map/list mode plus Rule / Reality / Facility / Divergence. Non-rule lens markers use fact-dimension palettes, and mock zoom remains interactive; selected place stays a real overlay sheet above the tab bar."
}
