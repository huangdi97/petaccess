{
  "id": "place.desktop",
  "title": "Place Desktop Contract v0.2.4 Executable Blueprint (Dossier with Views)",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "pages": [
    {
      "id": "place-ready",
      "route": "/#/place/5a9084d0-d2c7-5bb3-9914-fa7a11c53d9e",
      "expect": {
        "page": "place",
        "state": "ready",
        "fixture": "place-ready-v1",
        "entityId": "5a9084d0-d2c7-5bb3-9914-fa7a11c53d9e",
        "h1": "云栖中心·测试商场"
      }
    },
    {
      "id": "place-rules",
      "route": "/#/place/5a9084d0-d2c7-5bb3-9914-fa7a11c53d9e?view=rules",
      "expect": {
        "page": "place",
        "state": "ready",
        "fixture": "place-ready-v1",
        "entityId": "5a9084d0-d2c7-5bb3-9914-fa7a11c53d9e",
        "h1": "云栖中心·测试商场"
      }
    },
    {
      "id": "place-unknown",
      "route": "/#/place/3b5a341a-e550-5f0c-b35a-319ed43bd840",
      "expect": {
        "page": "place",
        "state": "unknown",
        "fixture": "place-unknown-v1",
        "entityId": "3b5a341a-e550-5f0c-b35a-319ed43bd840",
        "h1": "星河咖啡·栖霞分店"
      }
    },
    {
      "id": "place-space",
      "route": "/#/place/5a9084d0-d2c7-5bb3-9914-fa7a11c53d9e?view=space",
      "expect": {
        "page": "place",
        "state": "ready",
        "fixture": "place-ready-v1",
        "entityId": "5a9084d0-d2c7-5bb3-9914-fa7a11c53d9e",
        "h1": "云栖中心·测试商场"
      }
    },
    {
      "id": "place-reality",
      "route": "/#/place/5a9084d0-d2c7-5bb3-9914-fa7a11c53d9e?view=reality",
      "expect": {
        "page": "place",
        "state": "ready",
        "fixture": "place-ready-v1",
        "entityId": "5a9084d0-d2c7-5bb3-9914-fa7a11c53d9e",
        "h1": "云栖中心·测试商场"
      }
    }
  ],
  "elements": [
    {
      "id": "PLACE_RAIL_WIDTH",
      "ui": "app-rail",
      "fallbacks": [".desktop-rail"],
      "props": {
        "width": {
          "min": 64,
          "max": 72
        }
      },
      "severity": "FAIL"
    },
    {
      "id": "PLACE_TOP_CONTEXT_HEIGHT",
      "ui": "query-context",
      "fallbacks": ["[data-testid='query-context']"],
      "props": {
        "height": {
          "min": 56,
          "max": 64
        }
      },
      "severity": "FAIL"
    },
    {
      "id": "PLACE_MAIN_DOSSIER_X",
      "ui": "place-dossier",
      "fallbacks": [".place-dossier"],
      "props": {
        "left": {
          "min": 92,
          "max": 112
        }
      },
      "severity": "WARN"
    },
    {
      "id": "PLACE_MAIN_DOSSIER_WIDTH",
      "ui": "place-dossier",
      "fallbacks": [".place-dossier"],
      "props": {
        "width": {
          "min": 820,
          "max": 860
        }
      },
      "severity": "WARN"
    },
    {
      "id": "PLACE_MAIN_DOSSIER_PRESENT",
      "ui": "place-dossier",
      "fallbacks": [".place-dossier", "[class*='dossier']"],
      "props": {
        "count": {
          "min": 1
        }
      },
      "severity": "FAIL"
    },
    {
      "id": "PLACE_INSPECTOR_X",
      "ui": "place-inspector",
      "fallbacks": ["[data-testid='decision-inspector']"],
      "props": {
        "left": {
          "min": 936,
          "max": 1000
        }
      },
      "severity": "WARN",
      "note": "v0.2.5 §10: main column 820 (was 860) — inspector anchored after 820-wide dossier (~952)."
    },
    {
      "id": "PLACE_INSPECTOR_WIDTH",
      "ui": "place-inspector",
      "fallbacks": ["[data-testid='decision-inspector']"],
      "props": {
        "width": {
          "min": 320,
          "max": 350
        }
      },
      "severity": "FAIL"
    },
    {
      "id": "PLACE_INSPECTOR_STICKY",
      "ui": "place-inspector",
      "fallbacks": ["[data-testid='decision-inspector']"],
      "props": {
        "position": {
          "equals": "sticky"
        }
      },
      "severity": "FAIL"
    },
    {
      "id": "PLACE_IDENTITY_NAME_SIZE",
      "ui": "place-name",
      "fallbacks": [".place-dossier__name", "h1"],
      "props": {
        "fontSize": {
          "min": 27,
          "max": 29
        },
        "fontWeight": {
          "min": 600
        }
      },
      "severity": "FAIL"
    },
    {
      "id": "PLACE_DECISION_FONT_SIZE",
      "fallbacks": [
        "[data-testid='answer-status']",
        ".sub-answer .status",
        ".place-unknown__headline"
      ],
      "props": {
        "fontSize": {
          "min": 27,
          "max": 29
        }
      },
      "severity": "FAIL",
      "pages": ["place-ready", "place-unknown"]
    },
    {
      "id": "PLACE_SECTION_TITLE_SIZE",
      "fallbacks": [".place-section__title", ".place-unknown__title", ".rule-group__context"],
      "props": {
        "fontSize": {
          "min": 18,
          "max": 19
        }
      },
      "severity": "FAIL"
    },
    {
      "id": "PLACE_SECTION_GAP",
      "ui": "place-dossier",
      "fallbacks": [".place-dossier", "main"],
      "props": {
        "sectionGap": {
          "min": 24,
          "max": 40
        }
      },
      "severity": "FAIL",
      "pages": ["place-ready", "place-rules"],
      "note": "section rhythm applies to multi-section dossier views; §15 unknown overview is a single minimal pane (nav between identity and pane is not a section gap)."
    },
    {
      "id": "PLACE_NAV_PRESENT",
      "ui": "place-nav",
      "fallbacks": ["[data-ui='place-nav']"],
      "props": {
        "count": {
          "min": 1
        }
      },
      "severity": "FAIL"
    },
    {
      "id": "PLACE_RULES_VIEW_PRESENT",
      "ui": "place-rules-view",
      "fallbacks": ["[data-testid='place-rules-view']"],
      "props": {
        "count": {
          "min": 1
        }
      },
      "severity": "FAIL",
      "pages": ["place-rules"]
    },
    {
      "id": "PLACE_OVERVIEW_FULLPAGE_HEIGHT",
      "ui": "place-dossier",
      "fallbacks": [".place-dossier"],
      "props": {
        "height": {
          "max": 1500
        }
      },
      "severity": "FAIL",
      "pages": ["place-ready"]
    },
    {
      "id": "PLACE_ZONE_ROW_HEIGHT",
      "ui": "zone-row",
      "fallbacks": [".zone-row"],
      "props": {
        "height": {
          "min": 48,
          "max": 56
        }
      },
      "severity": "FAIL",
      "aggregate": "rows",
      "pages": ["place-ready"]
    },
    {
      "id": "PLACE_ACTIONS_MAX_FOUR",
      "ui": "place-identity",
      "fallbacks": [".place-dossier__head .row button, .place-dossier__actions"],
      "props": {
        "count": {
          "max": 4
        }
      },
      "severity": "WARN",
      "note": "Canonical Coexistence Passport first-screen actions: Evidence / Why / Correction-Contribution + quiet Watch utility."
    }
  ],
  "structure": [
    {
      "id": "PLACE_ZONES_NOT_CARDS",
      "selector": "[data-ui='place-zones'] .zone-row, .zone-row",
      "forbiddenClass": ["card", "panel"],
      "severity": "FAIL"
    },
    {
      "id": "PLACE_NO_RAW_ZONE_ENUM",
      "selector": "[data-ui='place-zones'], .zone-row",
      "forbiddenText": ["1F", "pet_area", "dining_area", "floor"],
      "severity": "FAIL"
    },
    {
      "id": "PLACE_SECTION_NOT_CARD",
      "selector": "[data-ui='place-dossier'] .place-section",
      "forbiddenClass": ["card", "panel"],
      "severity": "FAIL"
    },
    {
      "id": "PLACE_HISTORY_COLLAPSED_MOBILE",
      "selector": "[data-ui='place-history'] [aria-expanded='false'], [data-ui='place-history'] .disclosure-toggle",
      "min": 1,
      "severity": "FAIL",
      "pages": ["place-rules"]
    },
    {
      "id": "PLACE_RULES_VIEW_HISTORY_COLLAPSED",
      "selector": "[data-ui='place-rules-view'] [data-ui='place-history'], [data-ui='place-rules-view'] .disclosure-toggle",
      "disclosureDefault": "collapsed",
      "severity": "FAIL",
      "pages": ["place-rules"]
    },
    {
      "id": "PLACE_NO_STRAY_GLYPH",
      "selector": "[data-ui='place-dossier'], [data-testid='place-unknown']",
      "forbiddenText": [">", "<", ":::", "——"],
      "severity": "FAIL",
      "pages": ["place-ready", "place-unknown"]
    },
    {
      "id": "PLACE_NO_ENGINEERING_INVARIANT_COPY",
      "selector": "[data-ui='place-dossier'], [data-testid='place-unknown']",
      "forbiddenText": [
        "≠",
        "UNKNOWN",
        "ALLOWED",
        "PROHIBITED",
        "CONDITIONAL",
        "source_id",
        "rule_id",
        "zone_type"
      ],
      "severity": "FAIL",
      "pages": ["place-ready", "place-unknown"]
    },
    {
      "id": "PLACE_RULE_GROUP_HAS_CONTEXT",
      "selector": "[data-testid='rule-group-context'], [data-testid='rule-group']",
      "min": 1,
      "severity": "FAIL",
      "pages": ["place-rules"]
    },
    {
      "id": "PLACE_COEXISTENCE_LEAD_PRESENT",
      "selector": "[data-ui='place-coexistence-lead']",
      "min": 1,
      "severity": "FAIL",
      "pages": ["place-ready", "place-unknown"]
    },
    {
      "id": "PLACE_FIRST_SCREEN_ACTIONS",
      "selector": ".place-dossier__actions a, .place-dossier__actions button",
      "min": 3,
      "max": 4,
      "severity": "FAIL",
      "pages": ["place-ready", "place-unknown"],
      "mustContainTexts": ["查看证据", "为什么", "纠错"]
    },
    {
      "id": "PLACE_STAFF_RESPONSE_DETAIL",
      "selector": "[data-ui='place-staff-response']",
      "min": 1,
      "severity": "FAIL",
      "pages": ["place-reality"]
    },
    {
      "id": "PLACE_ANIMAL_FACILITY_DETAIL",
      "selector": "[data-ui='place-animal-facilities']",
      "min": 1,
      "severity": "FAIL",
      "pages": ["place-space"]
    }
  ],
  "density": [
    {
      "id": "PLACE_MAX_SEMANTIC_GAP",
      "selector": "[data-ui='place-dossier']",
      "metric": "largestVerticalGap",
      "max": 180,
      "severity": "WARN"
    },
    {
      "id": "PLACE_INFO_BLOCKS",
      "selector": "[data-ui='place-dossier']",
      "metric": "infoBlockCount",
      "min": 4,
      "severity": "FAIL",
      "pages": ["place-ready", "place-rules", "place-unknown"],
      "note": "Coexistence Passport stays populated even when Rule is unknown; unknown only affects the Rule dimension and never suppresses Reality/Staff/Facility/Evidence."
    }
  ],
  "hierarchy": [
    {
      "id": "PLACE_IDENTITY_TO_BODY",
      "a": ".place-dossier__name",
      "b": "body",
      "minRatio": 1.6,
      "severity": "FAIL"
    },
    {
      "id": "PLACE_DECISION_TO_BODY",
      "a": ".sub-answer .status, .place-unknown__headline",
      "b": "body",
      "minRatio": 1.75,
      "severity": "FAIL",
      "pages": ["place-ready", "place-unknown"]
    },
    {
      "id": "PLACE_SECTION_TO_BODY",
      "a": ".place-section__title, .place-unknown__title, .rule-group__context",
      "b": "body",
      "minRatio": 1.15,
      "severity": "FAIL"
    }
  ],
  "budget": [
    {
      "id": "PLACE_DESKTOP_FIRST_VIEWPORT_BLOCKS",
      "metric": "firstViewportBlocks",
      "selector": "[data-ui='place-dossier']",
      "min": 3,
      "severity": "FAIL"
    },
    {
      "id": "PLACE_DESKTOP_FIRST_VIEWPORT_LINES",
      "metric": "firstViewportTextLines",
      "selector": "[data-ui='place-dossier']",
      "max": 60,
      "warnAt": 48,
      "severity": "WARN"
    }
  ],
  "composition": [
    {
      "id": "PLACE_INSPECTOR_OCCUPANCY",
      "metric": "inspectorOccupancy",
      "selector": "[data-ui='place-inspector']",
      "container": "[data-ui='place-shell']",
      "min": 0.22,
      "severity": "FAIL"
    },
    {
      "id": "PLACE_STATUS_REPEAT",
      "metric": "primaryStatusRepeatCount",
      "selector": "[data-ui='place-dossier']",
      "text": "有条件进入",
      "max": 2,
      "severity": "FAIL"
    }
  ],
  "language": {
    "uuid": true,
    "enums": true,
    "invariants": true,
    "allcapsTokens": true,
    "refs": true
  },
  "notes": "Canonical v0.10-R1 Coexistence Passport: Rule UNKNOWN is one fact dimension, never a replacement screen. Overview keeps Rule + Reality together, exposes Staff/Facility/Divergence when facts exist, and keeps Evidence / Why / Correction actions."
}
