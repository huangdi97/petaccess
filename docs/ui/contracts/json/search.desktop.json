{
  "id": "search.desktop",
  "title": "Search Desktop Contract",
  "viewport": { "width": 1440, "height": 900 },
  "pages": [
    { "id": "search-ready", "route": "/#/search" },
    { "id": "search-selected", "route": "/#/search?q=%E6%98%9F%E6%B2%B3" }
  ],
  "elements": [
    {
      "id": "SEARCH_RAIL_WIDTH",
      "ui": "app-rail",
      "fallbacks": [".desktop-rail"],
      "props": { "width": { "min": 64, "max": 72 } },
      "severity": "FAIL"
    },
    {
      "id": "SEARCH_TOP_CONTEXT_HEIGHT",
      "ui": "query-context",
      "fallbacks": ["[data-testid='query-context']"],
      "props": { "height": { "min": 56, "max": 64 } },
      "severity": "FAIL"
    },
    {
      "id": "SEARCH_RESULT_PANE_WIDTH",
      "ui": "search-results-pane",
      "fallbacks": [".search-result-pane", "[class*='search-result-pane']"],
      "props": { "width": { "min": 380, "max": 420 } },
      "severity": "FAIL"
    },
    {
      "id": "SEARCH_DETAIL_PANE_PRESENT",
      "ui": "search-detail-pane",
      "fallbacks": ["[data-testid='decision-inspector']", ".search-inspector"],
      "props": { "count": { "min": 1 } },
      "severity": "FAIL"
    },
    {
      "id": "SEARCH_DETAIL_CONTENT_WIDTH",
      "ui": "search-detail-content",
      "fallbacks": [
        "[data-testid='decision-inspector'] .decision-content",
        "[data-testid='decision-inspector']"
      ],
      "props": { "maxChildWidth": { "min": 680, "max": 760 } },
      "severity": "FAIL"
    },
    {
      "id": "SEARCH_DETAIL_CONTENT_LEFT_OFFSET",
      "ui": "search-detail-content",
      "fallbacks": ["[data-testid='decision-inspector']"],
      "props": { "left": { "min": 32, "max": 48 } },
      "severity": "WARN"
    },
    {
      "id": "SEARCH_INPUT_HEIGHT",
      "ui": "search-input",
      "fallbacks": ["[data-testid='search-input']"],
      "props": { "height": { "min": 44, "max": 48 } },
      "severity": "FAIL"
    },
    {
      "id": "SEARCH_ROW_HEIGHT",
      "ui": "search-result-row",
      "fallbacks": [
        "[data-testid^='result-']:not([data-testid='result-rules'])",
        "ul.result-list li"
      ],
      "props": { "height": { "min": 108, "max": 136 } },
      "severity": "FAIL",
      "aggregate": "rows"
    },
    {
      "id": "SEARCH_ROW_RADIUS_ZERO",
      "ui": "search-result-row",
      "fallbacks": ["ul.result-list li"],
      "props": { "borderRadius": { "max": 0 } },
      "severity": "FAIL",
      "aggregate": "rows"
    },
    {
      "id": "SEARCH_DETAIL_FIRST_VIEWPORT_HEIGHT",
      "ui": "search-detail-content",
      "fallbacks": ["[data-testid='decision-inspector']"],
      "props": { "contentHeightInViewport": { "min": 360 } },
      "severity": "WARN"
    },
    {
      "id": "SEARCH_COUNT_LINE",
      "ui": "search-count",
      "fallbacks": ["[data-testid='search-count']"],
      "props": { "count": { "min": 1 } },
      "severity": "FAIL"
    }
  ],
  "structure": [
    {
      "id": "NO_RESULT_CARD_ROWS",
      "selector": "ul.result-list li",
      "forbiddenClass": ["card", "panel"],
      "severity": "FAIL"
    },
    {
      "id": "NO_ROW_PILL_WALL",
      "selector": "[data-ui='search-results-pane'] .pill",
      "max": 0,
      "fallbackSelector": ".search-result-pane .pill",
      "severity": "FAIL"
    }
  ],
  "density": [
    {
      "id": "SEARCH_DETAIL_MAX_SEMANTIC_GAP",
      "selector": "[data-ui='search-detail-content']",
      "metric": "largestVerticalGap",
      "max": 180,
      "severity": "FAIL"
    }
  ],
  "language": { "uuid": true, "enums": true, "invariants": true, "allcapsTokens": true },
  "notes": "Detail content must not stretch full pane; selected row uses tint + 2px left indicator (see contract md 25.5)."
}
