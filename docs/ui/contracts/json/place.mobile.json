      "min": 2,
      "pages": [
        "place-mobile-ready"
      ],
      "severity": "FAIL"
    },
    {
      "id": "PLACE_MOBILE_FIRST_VIEWPORT_LINES",
      "metric": "firstViewportTextLines",
      "selector": "[data-ui='place-dossier']",
      "max": 30,
      "warnAt": 27,
      "pages": [
        "place-mobile-ready"
      ],
      "severity": "FAIL",
      "note": "v0.2.5 §11: mobile overview gained two required summary rows (Space/Evidence) in the first screen; budget re-baselined from 24 to 30."
    }
  ],
  "composition": [
    {
      "id": "PLACE_MOBILE_STATUS_REPEAT",
      "metric": "primaryStatusRepeatCount",
      "selector": "[data-ui='place-dossier']",
      "text": "有条件进入",
      "max": 2,
      "severity": "FAIL"
    }
  ],
  "language": {
    "uuid": true,
    "enums": true,
    "invariants": true,
    "allcapsTokens": true,
    "refs": true
  },
  "notes": "Canonical mobile Coexistence Passport: Rule UNKNOWN remains one fact dimension and never suppresses Reality/Staff/Facility/Evidence. Overview is single-column; detail views expose staff response and animal facilities; history/provenance stay progressive."
