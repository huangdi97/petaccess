{
  "id": "place.mobile",
  "title": "Place Mobile Contract v0.2.3 Executable Blueprint",
  "viewport": {
    "width": 430,
    "height": 932
  },
  "pages": [
    {
      "id": "place-mobile-ready",
      "route": "/#/place/5a9084d0-d2c7-5bb3-9914-fa7a11c53d9e",
      "expect": {
        "page": "place",
        "state": "ready",
        "fixture": "place-ready-v1",
        "entityId": "5a9084d0-d2c7-5bb3-9914-fa7a11c53d9e",
        "h1": "云栖中心·测试商场"
      }
    },
    {
      "id": "place-mobile-rules",
      "route": "/#/place/5a9084d0-d2c7-5bb3-9914-fa7a11c53d9e?view=rules",
      "expect": {
        "page": "place",
        "state": "ready",
        "fixture": "place-ready-v1",
        "entityId": "5a9084d0-d2c7-5bb3-9914-fa7a11c53d9e",
        "h1": "云栖中心·测试商场"
      }
    }
  ],
  "elements": [
    {
      "id": "PLACE_MOBILE_INSPECTOR_ABSENT",
      "ui": "place-inspector",
      "fallbacks": ["[data-testid='decision-inspector']"],
      "props": {
        "count": {
          "max": 0
        }
      },
      "severity": "FAIL"
    },
    {
      "id": "PLACE_MOBILE_NAME_VISIBLE",
      "ui": "place-name",
      "fallbacks": [".place-dossier__name", "h1"],
      "props": {
        "count": {
          "min": 1
        }
      },
      "severity": "FAIL"
    },
    {
      "id": "PLACE_MOBILE_DECISION_VISIBLE",
      "ui": "place-decision",
      "fallbacks": ["[data-testid='section-answer'], [data-testid='answer-status']"],
      "props": {
        "count": {
          "min": 1
        }
      },
      "severity": "FAIL",
      "pages": ["place-mobile-ready"]
    },
    {
      "id": "PLACE_MOBILE_DECISION_SIZE",
      "fallbacks": ["[data-testid='answer-status']"],
      "props": {
        "fontSize": {
          "min": 23,
          "max": 25
        }
      },
      "severity": "WARN",
      "pages": ["place-mobile-ready"]
    },
    {
      "id": "PLACE_MOBILE_BOTTOM_NAV_HEIGHT",
      "ui": "mobile-tabbar",
      "fallbacks": ["[data-testid='mobile-tabbar']"],
      "props": {
        "height": {
          "min": 58,
          "max": 64
        }
      },
      "severity": "FAIL"
    },
    {
      "id": "PLACE_MOBILE_OVERVIEW_FULLPAGE_HEIGHT",
      "ui": "place-dossier",
      "fallbacks": [".place-dossier"],
      "props": {
        "height": {
          "max": 2000
        }
      },
      "severity": "FAIL",
      "pages": ["place-mobile-ready"]
    }
  ],
  "structure": [
    {
      "id": "PLACE_MOBILE_HISTORY_COLLAPSED",
      "selector": "[data-ui='place-history'], [class*='history']",
      "disclosureDefault": "collapsed",
      "severity": "FAIL",
      "pages": ["place-mobile-rules"]
    },
    {
      "id": "PLACE_MOBILE_ZONES_NOT_CARDS",
      "selector": ".zone-row",
      "forbiddenClass": ["card", "panel"],
      "severity": "FAIL"
    },
    {
      "id": "PLACE_MOBILE_OVERVIEW_SUMMARY_PRESENT",
      "selector": "[data-testid='overview-zones'], [data-testid='overview-evidence']",
      "min": 2,
      "severity": "FAIL",
      "pages": ["place-mobile-ready"]
    },
    {
      "id": "PLACE_NO_STRAY_GLYPH",
      "selector": "[data-ui='place-dossier'], [data-testid='place-unknown']",
      "forbiddenText": [">", "<", ":::", "——"],
      "severity": "FAIL",
      "pages": ["place-mobile-ready", "place-mobile-rules"]
    },
    {
      "id": "PLACE_NO_ENGINEERING_INVARIANT_COPY",
      "selector": "[data-ui='place-dossier'], [data-testid='place-unknown']",
      "forbiddenText": [
        "≠",
        "UNKNOWN",
        "ALLOWED",
        "PROHIBITED",
        "CONDITIONAL",
        "source_id",
        "rule_id",
        "zone_type"
      ],
      "severity": "FAIL",
      "pages": ["place-mobile-ready", "place-mobile-rules"]
    },
    {
      "id": "PLACE_MOBILE_COEXISTENCE_LEAD_PRESENT",
      "selector": "[data-ui='place-coexistence-lead']",
      "min": 1,
      "severity": "FAIL",
      "pages": ["place-mobile-ready"]
    },
    {
      "id": "PLACE_MOBILE_FIRST_SCREEN_ACTIONS",
      "selector": ".place-dossier__actions a, .place-dossier__actions button",
      "min": 3,
      "max": 4,
      "severity": "FAIL",
      "pages": ["place-mobile-ready"],
      "mustContainTexts": ["查看证据", "为什么", "纠错"]
    }
  ],
  "density": [
    {
      "id": "PLACE_MOBILE_MAX_GAP",
      "selector": "[data-ui='place-dossier']",
      "metric": "largestVerticalGap",
      "max": 180,
      "severity": "FAIL"
    }
  ],
  "budget": [
    {
      "id": "PLACE_MOBILE_FIRST_VIEWPORT_BLOCKS",
      "metric": "firstViewportBlocks",
      "selector": "[data-ui='place-dossier']",
      "min": 2,
      "pages": ["place-mobile-ready"],
      "severity": "FAIL"
    },
    {
      "id": "PLACE_MOBILE_FIRST_VIEWPORT_LINES",
      "metric": "firstViewportTextLines",
      "selector": "[data-ui='place-dossier']",
      "max": 30,
      "warnAt": 27,
      "pages": ["place-mobile-ready"],
      "severity": "FAIL",
      "note": "v0.2.5 §11: mobile overview gained two required summary rows (Space/Evidence) in the first screen; budget re-baselined from 24 to 30."
    }
  ],
  "composition": [
    {
      "id": "PLACE_MOBILE_STATUS_REPEAT",
      "metric": "primaryStatusRepeatCount",
      "selector": "[data-ui='place-dossier']",
      "text": "有条件进入",
      "max": 2,
      "severity": "FAIL"
    }
  ],
  "language": {
    "uuid": true,
    "enums": true,
    "invariants": true,
    "allcapsTokens": true,
    "refs": true
  },
  "notes": "Canonical mobile Coexistence Passport: single column; identity/actions -> Rule + Reality first-screen lead -> Space/Evidence summaries; history/provenance remain progressive disclosure; bottom nav 58–64."
}
