  "elements": [
    {
      "id": "PLACE_MOBILE_INSPECTOR_ABSENT",
      "ui": "place-inspector",
      "fallbacks": [
        "[data-testid='decision-inspector']"
      ],
      "props": {
        "count": {
          "max": 0
        }
      },
      "severity": "FAIL"
    },
    {
      "id": "PLACE_MOBILE_NAME_VISIBLE",
      "ui": "place-name",
      "fallbacks": [
        ".place-dossier__name",
        "h1"
      ],
      "props": {
        "count": {
          "min": 1
        }
      },
      "severity": "FAIL"
    },
    {
      "id": "PLACE_MOBILE_DECISION_VISIBLE",
      "ui": "place-decision",
      "fallbacks": [
        "[data-testid='section-answer'], [data-testid='answer-status']"
      ],
      "props": {
        "count": {
          "min": 1
        }
      },
      "severity": "FAIL",
      "pages": [
        "place-mobile-ready"
      ]
    },
    {
      "id": "PLACE_MOBILE_DECISION_SIZE",
      "fallbacks": [
        "[data-testid='answer-status']"
      ],
      "props": {
        "fontSize": {
          "min": 23,
          "max": 25
        }
      },
      "severity": "WARN",
      "pages": [
        "place-mobile-ready"
      ]
    },
    {
      "id": "PLACE_MOBILE_BOTTOM_NAV_HEIGHT",
      "ui": "mobile-tabbar",
      "fallbacks": [
        "[data-testid='mobile-tabbar']"
      ],
      "props": {
        "height": {
          "min": 58,
          "max": 64
        }
      },
      "severity": "FAIL"
    },
    {
      "id": "PLACE_MOBILE_OVERVIEW_FULLPAGE_HEIGHT",
      "ui": "place-dossier",
      "fallbacks": [
        ".place-dossier"
      ],
      "props": {
        "height": {
          "max": 2000
        }
      },
      "severity": "FAIL",
      "pages": [
        "place-mobile-ready"
      ]
    }
  ],
  "structure": [
    {
      "id": "PLACE_MOBILE_HISTORY_COLLAPSED",
      "selector": "[data-ui='place-history'], [class*='history']",
      "disclosureDefault": "collapsed",
      "severity": "FAIL",
      "pages": [
        "place-mobile-rules"
      ]
    },
    {
      "id": "PLACE_MOBILE_ZONES_NOT_CARDS",
      "selector": ".zone-row",
      "forbiddenClass": [
        "card",
        "panel"
      ],
      "severity": "FAIL"
    },
    {
      "id": "PLACE_MOBILE_OVERVIEW_SUMMARY_PRESENT",
      "selector": "[data-testid='overview-zones'], [data-testid='overview-evidence']",
      "min": 2,
      "severity": "FAIL",
      "pages": [
        "place-mobile-ready"
      ]
    },
    {
      "id": "PLACE_NO_STRAY_GLYPH",
      "selector": "[data-ui='place-dossier'], [data-testid='place-unknown']",
      "forbiddenText": [
        ">",
        "<",
        ":::",
        "——"
      ],
      "severity": "FAIL",
      "pages": [
        "place-mobile-ready",
        "place-mobile-rules"
      ]
    },
    {
      "id": "PLACE_NO_ENGINEERING_INVARIANT_COPY",
      "selector": "[data-ui='place-dossier'], [data-testid='place-unknown']",
      "forbiddenText": [
        "≠",
        "UNKNOWN",
        "ALLOWED",
        "PROHIBITED",
        "CONDITIONAL",
        "source_id",
        "rule_id",
        "zone_type"
      ],
      "severity": "FAIL",
      "pages": [
        "place-mobile-ready",
        "place-mobile-rules"
      ]
    },
    {
      "id": "PLACE_MOBILE_COEXISTENCE_LEAD_PRESENT",
      "selector": "[data-ui='place-coexistence-lead']",
      "min": 1,
      "severity": "FAIL",
      "pages": [
        "place-mobile-ready",
        "place-mobile-unknown"
      ]
    },
    {
      "id": "PLACE_MOBILE_FIRST_SCREEN_ACTIONS",
      "selector": ".place-dossier__actions a, .place-dossier__actions button",
      "min": 3,
      "max": 4,
      "severity": "FAIL",
      "pages": [
        "place-mobile-ready",
        "place-mobile-unknown"
      ],
      "mustContainTexts": [
        "查看证据",
        "为什么",
        "纠错"
      ]
    },
    {
      "id": "PLACE_MOBILE_STAFF_RESPONSE_DETAIL",
      "selector": "[data-ui='place-staff-response']",
      "min": 1,
      "severity": "FAIL",
      "pages": [
        "place-mobile-reality"
      ]
    },
    {
      "id": "PLACE_MOBILE_ANIMAL_FACILITY_DETAIL",
      "selector": "[data-ui='place-animal-facilities']",
      "min": 1,
      "severity": "FAIL",
      "pages": [
        "place-mobile-space"
      ]
    }
  ],
  "density": [
    {
      "id": "PLACE_MOBILE_MAX_GAP",
      "selector": "[data-ui='place-dossier']",
      "metric": "largestVerticalGap",
      "max": 180,
      "severity": "FAIL"
