{
  "id": "map",
  "title": "Map Contract",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "pages": [
    {
      "id": "map-ready",
      "route": "/#/map",
      "expect": {
        "page": "map",
        "state": "ready",
        "fixture": "map-ready-v1",
        "h1": "规则地图"
      }
    },
    {
      "id": "map-reality",
      "route": "/#/map?lens=reality",
      "expect": {
        "page": "map",
        "state": "ready",
        "fixture": "map-ready-v1",
        "h1": "规则地图"
      }
    },
    {
      "id": "map-facility",
      "route": "/#/map?lens=facility",
      "expect": {
        "page": "map",
        "state": "ready",
        "fixture": "map-ready-v1",
        "h1": "规则地图"
      }
    },
    {
      "id": "map-divergence",
      "route": "/#/map?lens=divergence",
      "expect": {
        "page": "map",
        "state": "ready",
        "fixture": "map-ready-v1",
        "h1": "规则地图"
      }
    }
  ],
  "elements": [
    {
      "id": "MAP_RESULT_PANE_WIDTH",
      "ui": "map-result-pane",
      "fallbacks": [
        "[data-testid='map-result-pane'], .map-pane"
      ],
      "props": {
        "width": {
          "min": 360,
          "max": 420
        }
      },
      "severity": "FAIL"
    },
    {
      "id": "MAP_CANVAS_PRESENT",
      "ui": "map-canvas",
      "fallbacks": [
        "[data-testid='map'], .map-canvas"
      ],
      "props": {
        "count": {
          "min": 1
        }
      },
      "severity": "FAIL"
    },
    {
      "id": "MAP_FILTER_TOGGLE",
      "ui": "map-filter-toggle",
      "fallbacks": [
        "[data-testid='map-filter-toggle']"
      ],
      "props": {
        "count": {
          "min": 1
        }
      },
      "severity": "WARN"
    },
    {
      "id": "MAP_PREVIEW_FOCUSED",
      "ui": "place-preview",
      "fallbacks": [
        "[data-testid='place-preview']"
      ],
      "props": {
        "count": {
          "min": 1
        }
      },
      "severity": "WARN"
    },
    {
      "id": "MAP_CANVAS_OCCUPANCY",
      "ui": "map-canvas",
      "fallbacks": [
        "[data-testid='map'], .map-canvas"
      ],
      "props": {
        "width": {
          "min": 700
        }
      },
      "severity": "FAIL",
      "note": "v0.2.7 §40：desktop 1440 下 map canvas 必须占主导（>700px），不再是窄条。"
    },
    {
      "id": "MAP_SELECTED_HIERARCHY",
      "ui": "map-marker-selected",
      "fallbacks": [
        "[data-selected='true']"
      ],
      "props": {
        "width": {
          "min": 14,
          "max": 40
        },
        "shadowed": {
          "min": 1
        }
      },
      "severity": "FAIL",
      "note": "v0.2.7 §40：selected marker 必须 scale ≥14px 且浮起（halo/elevation）。"
    },
    {
      "id": "MAP_LENSBAR_PRESENT",
      "ui": "map-lensbar",
      "fallbacks": [
        "[data-ui='map-lensbar']"
      ],
      "props": {
        "count": {
          "min": 1
        }
      },
      "severity": "FAIL"
    }
  ],
  "structure": [
    {
      "id": "MAP_NO_FILTER_PILL_WALL",
      "selector": "[data-ui='map-filter'] .pill, [data-testid='map-filter-pills']",
      "max": 0,
      "severity": "FAIL"
    },
    {
      "id": "MAP_MOCK_ROAD_LINES",
      "selector": "[data-ui='mock-map'] path",
      "min": 3,
      "severity": "FAIL"
    },
    {
      "id": "MAP_MOCK_BLOCK_POLYGONS",
      "selector": "[data-ui='mock-map'] polygon",
      "min": 2,
      "severity": "FAIL"
    },
    {
      "id": "MAP_MOCK_MARKERS",
      "selector": "[data-ui='map-marker'], [data-ui='map-marker-selected']",
      "min": 4,
      "severity": "FAIL"
    },
    {
      "id": "MAP_MOCK_SELECTED_MARKER",
      "selector": "[data-ui='map-marker-selected'], [data-selected='true']",
      "min": 1,
      "severity": "FAIL"
    },
    {
      "id": "MAP_MOCK_ZOOM_AFFORDANCE",
      "selector": "[data-ui='map-zoom']",
      "min": 1,
      "severity": "WARN"
    },
    {
      "id": "MAP_RESULT_ROWS_NOT_CARDS",
      "selector": ".map-place-row",
      "forbiddenClass": [
        "card",
        "panel"
      ],
      "severity": "FAIL"
    },
    {
      "id": "MAP_FOUR_LENSES",
      "selector": "[data-ui='map-lensbar'] button",
      "min": 4,
      "max": 4,
      "severity": "FAIL",
      "mustContainTexts": [
        "规则",
        "现场",
        "设施",
        "规则×现场"
      ]
    },
    {
      "id": "MAP_ONE_ACTIVE_LENS",
      "selector": "[data-ui='map-lensbar'] button[aria-pressed='true']",
      "min": 1,
      "max": 1,
      "severity": "FAIL"
    },
    {
      "id": "MAP_ZOOM_CONTROLS_INTERACTIVE",
      "selector": "[data-ui='map-zoom'] button:not(:disabled)",
      "min": 1,
      "severity": "FAIL"
    },
    {
      "id": "MAP_NON_RULE_LENS_FACTS_VISIBLE",
      "selector": ".map-place-row__lens-fact",
      "min": 1,
      "severity": "FAIL",
      "pages": [
        "map-reality",
        "map-facility",
        "map-divergence"
      ]
    }
  ],
  "density": [],
  "language": {
    "uuid": true,
    "enums": true,
    "invariants": true,
    "allcapsTokens": true,
    "refs": true
  },
  "notes": "Map is the canvas and exposes Rule / Reality / Facility / Divergence over one CoexistenceSnapshot. Non-rule lenses use lens-specific fact labels/palettes rather than access-green semantics; mock zoom controls remain genuinely interactive until a real provider replaces the renderer."
}
