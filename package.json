{
  "name": "petaccess-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Place Animal Access Map monorepo root",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "client:gen": "pnpm --filter @petaccess/api-client generate",
    "admin:dev": "pnpm --filter @petaccess/admin dev",
    "admin:build": "pnpm --filter @petaccess/admin build",
    "client:dev": "pnpm --filter @petaccess/client dev:h5",
    "lint:fe": "eslint .",
    "format:fe": "prettier --write .",
    "format:check:fe": "prettier --check ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.70.0"
  }
}
