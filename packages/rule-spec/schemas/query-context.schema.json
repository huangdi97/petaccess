{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petaccess.local/schemas/query-context.schema.json",
  "title": "QueryContext",
  "description": "Deterministic evaluator input: who/what animal goes where, when, doing what (design #12).",
  "type": "object",
  "required": ["animal", "place_id", "date_time", "intended_action"],
  "properties": {
    "animal": {
      "type": "object",
      "required": ["species", "service_role"],
      "properties": {
        "species": { "enum": ["dog", "cat", "other"] },
        "service_role": { "enum": ["none", "in_training", "working", "unknown"] },
        "weight_kg": { "type": ["number", "null"], "minimum": 0 },
        "shoulder_height_cm": { "type": ["number", "null"], "minimum": 0 },
        "count": { "type": ["integer", "null"], "minimum": 1 },
        "registration_status": { "type": ["string", "null"], "enum": [null, "registered", "unregistered", "unknown"] },
        "vaccination_status": { "type": ["string", "null"], "enum": [null, "vaccinated", "unvaccinated", "unknown"] }
      }
    },
    "place_id": { "type": "string" },
    "zone_id": { "type": ["string", "null"] },
    "date_time": { "type": "string", "format": "date-time" },
    "intended_action": { "$ref": "access-action.schema.json" }
  }
}
