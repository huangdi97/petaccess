  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.1.10"
  },
  "petaccessRole": "canonical-consumer",
  "canonicalRuntimes": [
    "web",
    "tauri-windows",
    "tauri-android"
