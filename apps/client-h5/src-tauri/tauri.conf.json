{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PetAccess",
  "version": "0.1.0",
  "identifier": "com.petaccess.map",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "PetAccess 宠物共处",
        "width": 1000,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:*; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Lifestyle",
    "shortDescription": "宠物准入与公共空间共处规则地图 — Early Preview",
    "longDescription": "查询场所对宠物的准入规则、查看经核验的现场事实并贡献线索。当前为 0.1.0 Early Preview：数据可能为空，不代表场所没有规则。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"],
        "installerIcon": "icons/icon.ico"
      }
    },
    "android": {
      "minSdkVersion": 24,
      "autoIncrementVersionCode": false
    }
  }
}