<template>
  <view class="page">
    <view class="panel">
      <strong v-if="step === 1">你知道这里对普通犬的规则吗？</strong>
      <view v-if="step === 1" class="row">
        <button v-for="opt in ['明确允许', '明确限制', '有条件']" :key="opt" @click="pickKnow(opt)">{{ opt }}</button>
        <button @click="goVerify">不确定 / 直接核验</button>
      </view>

      <block v-else-if="step === 2">
        <text class="strong">在哪里？</text>
        <view class="row">
          <button @click="zone = ''; step = 3">全场 / 不确定</button>
          <button v-for="z in zones" :key="z.id" @click="zone = z.id; step = 3">{{ z.name }}</button>
        </view>
      </block>

      <block v-else-if="step === 3">
        <text class="strong">需要什么条件？（可多选）</text>
        <view class="row">
          <button v-for="c in conditionOptions" :key="c.key"
                  :type="conditions.includes(c.key) ? 'primary' : 'default'"
                  @click="toggleCondition(c.key)">{{ c.label }}</button>
        </view>
        <button type="primary" @click="step = 4">下一步</button>
      </block>

      <block v-else-if="step === 4">
        <text class="label">现场告示照片（可选）</text>
        <button @click="pickImage">选择照片（OCR 仅作审核参考）</button>
        <button type="primary" @click="step = 5">下一步</button>
      </block>

      <block v-if="step === 5 || step === 6">
        <text class="strong">现场实际情况</text>
        <view class="row">
          <button @click="verify('still_valid')">规则仍有效</button>
          <button @click="verify('changed')">规则已变化</button>
          <button @click="observe()">提交现场观察</button>
        </view>
        <text v-if="msg" class="notice">{{ msg }}</text>
      </block>
    </view>
    <text class="notice">位置仅记录分桶后的核验结果（距离/精度），不保存原始 GPS 轨迹。高频提交会被限流。</text>
  </view>
</template>

<script setup lang="ts">
import { onLoad } from "@dcloudio/uni-app";
import { ref } from "vue";
import { client } from "@petaccess/client-core";

const placeId = ref("");
const step = ref(1);
const knowRule = ref("");
const scope = ref("dog");
const zone = ref("");
const conditions = ref<string[]>([]);
const result = ref("");
const msg = ref("");
const zones = ref<{ id: string; name: string }[]>([]);

const conditionOptions = [
  { key: "leash_required", label: "需牵引" },
  { key: "carrier_required", label: "需宠物包" },
  { key: "stroller_required", label: "需推车" },
  { key: "no_ground", label: "不可落地" },
];

onLoad(async (query) => {
  placeId.value = (query?.["id"] as string) ?? "";
  try {
    zones.value = await client.zones(placeId.value);
  } catch (e) { /* anonymous */ }
});

function pickKnow(opt: string) {
  knowRule.value = opt;
  step.value = 2;
}
function toggleCondition(key: string) {
  conditions.value = conditions.value.includes(key)
    ? conditions.value.filter((k) => k !== key)
    : [...conditions.value, key];
}
function goVerify() {
  step.value = 5;
}
function pickImage() {
  uni.chooseImage({
    count: 1,
    success: () => {
      /* 上传走存储 Provider；OCR 结果进入审核队列（design #20） */
    },
  });
}

async function verify(v: "still_valid" | "changed") {
  try {
    const rules = await client.rules(placeId.value);
    const target = rules.find((r) => r.status === "current");
    await client.verify({
      place_id: placeId.value, rule_id: target?.id ?? null, result: v,
      note: "现场核验", proximity_verified: true,
      distance_bucket: "<100m", accuracy_bucket: "10-50m",
    });
    msg.value = "核验已记录 ✓";
  } catch (e) {
    msg.value = "提交失败（需登录）";
  }
}

async function observe() {
  try {
    await client.createObservation({
      place_id: placeId.value,
      zone_id: zone.value || null,
      occurred_at: new Date().toISOString(),
      occurred_precision: "same_day",
      animal_scope: scope.value || "dog",
      observed_action: "enter",
      staff_action: "no_interaction_observed",
      place_confidence: "confirmed_on_site",
      note: `快速贡献：${knowRule.value}`,
      proximity_verified: true,
      distance_bucket: "<100m",
      accuracy_bucket: "10-50m",
    });
    msg.value = "观察已提交（Observation 与规则并存，不会自动变成规则）";
  } catch (e) {
    msg.value = "提交失败（需登录）";
  }
}
</script>

<style>
.page { padding: 16px; }
.panel { background-color: #ffffff; border-radius: 12px; padding: 14px; }
.row { flex-direction: row; flex-wrap: wrap; margin-top: 10px; }
.strong { font-weight: bold; }
.label { color: #69747f; font-size: 12px; }
.notice { color: #69747f; font-size: 12px; margin-top: 8px; }
</style>
