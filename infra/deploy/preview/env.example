# Copy to infra/deploy/preview/.env.preview and replace every CHANGE_ME value.
# Generate secrets with e.g.:
#   openssl rand -hex 24   # PostgreSQL / S3
#   openssl rand -hex 32   # JWT

PETACCESS_PREVIEW_DOMAIN=preview-api.example.com

POSTGRES_DB=petaccess_preview
POSTGRES_USER=petaccess
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_HEX_24
DATABASE_URL=postgresql+psycopg://petaccess:CHANGE_ME_RANDOM_HEX_24@db:5432/petaccess_preview

REDIS_URL=redis://redis:6379/0
CELERY_TASK_QUEUE=petaccess_preview

S3_ACCESS_KEY=petaccess-preview
S3_SECRET_KEY=CHANGE_ME_RANDOM_HEX_24
S3_BUCKET=petaccess-preview
S3_REGION=us-east-1

JWT_SECRET=CHANGE_ME_RANDOM_HEX_32

# Provider truth: fallback remains explicit until real Tencent keys exist.
MAP_PROVIDER=mock
FEATURE_REAL_MAP=false
TENCENT_MAP_KEY_CLIENT=
TENCENT_MAP_KEY_SERVER=

# Real AI is externally blocked until an adapter + real provider key are supplied.
AI_PROVIDER=mock
VISION_PROVIDER=mock
OCR_PROVIDER=mock
FEATURE_REAL_AI=false
AI_API_KEY=

NOTIFICATION_PROVIDER=mock
